---
// The search box: in the top bar on every page, large on the start page.
// Results appear below it while typing (logic in client.ts).
import { type Lang, site } from './data';

interface Props {
	lang: Lang;
	variant?: 'bar' | 'hero';
}

const { lang, variant = 'bar' } = Astro.props;
const s = site(lang);
const { t } = s;
---

<div class:list={['search', { 'hero-search': variant === 'hero' }]} transition:persist={`search-${variant}-${lang}`}>
	<svg class="search-icon" aria-hidden="true" viewBox="0 0 24 24" width={variant === 'hero' ? 22 : 18} height={variant === 'hero' ? 22 : 18}>
		<circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"></circle>
		<path d="m20 20-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
	</svg>
	<input
		id="c5-search"
		type="search"
		placeholder={variant === 'hero' ? t.heroPlaceholder : t.searchPlaceholder}
		aria-label={t.searchLabel}
		autocomplete="off"
		spellcheck="false"
		role="combobox"
		aria-expanded="false"
		aria-controls="c5-results"
		aria-autocomplete="list"
		data-index={s.searchIndex}
		data-label-criteria={t.searchCriteria}
		data-label-passages={t.searchPassages}
		data-label-customer={t.searchCustomer}
		data-customer-anchor={t.customerAnchor}
		data-label-empty={t.noResults}
	/>
	{variant === 'bar' && <kbd class="search-key" aria-hidden="true">/</kbd>}
	<div id="c5-results" class="results" role="listbox" aria-label={t.searchLabel} hidden></div>
</div>
