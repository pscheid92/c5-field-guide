---
// One topic page: the criteria of a technical area, grouped by BSI domain, as
// rows like the domain overview. The assignment is Claude's (data/ai/
// topics.yml) and marked as such; the criteria themselves are BSI's.
import topicsDe from '../generated/topics.de.json';
import topicsEn from '../generated/topics.en.json';
import Attribution from './Attribution.astro';
import Layout from './Layout.astro';
import { type Lang, site } from './data';

interface Props {
	lang: Lang;
	id: string;
}

const s = site(Astro.props.lang);
const { t } = s;
const other = site(s.lang === 'de' ? 'en' : 'de');
const data = s.lang === 'de' ? topicsDe : topicsEn;
const topic = data.topics.find((x) => x.id === Astro.props.id)!;
const url = `${s.topics}${topic.slug}/`;
const otherUrl = `${other.topics}${topic.slugs[other.lang]}/`;
---

<Layout lang={s.lang} view="page" title={topic.name} otherLangUrl={otherUrl} markdown={`${url}index.html.md`}>
	<div class="page">
		<article class="doc">
			<p class="crumb"><a href={s.topics}>{t.topicsTitle}</a></p>
			<h1>{topic.name}</h1>
			<p class="doc-meta">{t.topicCount(topic.criteriaCount, topic.domains.length)}</p>
			<p class="changes-intro">{topic.intro}</p>
			<aside class="ai-notice">
				<p class="ai-notice-label">{t.topicsAiLabel}</p>
				<p>{t.topicsNotice}</p>
			</aside>

			{
				topic.domains.map((d) => (
					<section class="overview-theme">
						<h2>
							<a href={s.domainUrl(d.code)}>{d.code}</a> · {d.title}
						</h2>
						<ul class="overview">
							{d.criteria.map((c) => (
								<li>
									<a href={c.url}>
										<span class="overview-id">{c.id}</span>
										<span>
											<span class="overview-title">{c.name}</span>
											<span class="overview-meta">
												{c.partial ? t.onlySubs(c.subs, c.subsTotal) : t.subMeta(c.subsTotal, c.basic, c.subsTotal - c.basic)}
											</span>
										</span>
									</a>
								</li>
							))}
						</ul>
					</section>
				))
			}

			<section class="topics-more">
				<h2>{t.otherTopics}</h2>
				<ul class="crosscut-list">
					{
						data.topics
							.filter((x) => x.id !== topic.id)
							.map((x) => (
								<li>
									<a href={`${s.topics}${x.slug}/`}>{x.name}</a>
									<span>{t.topicCount(x.criteriaCount, x.domains.length)}</span>
								</li>
							))
					}
				</ul>
			</section>

			<p class="attribution">{t.topicsAttribution(data.generated, site('de').data.version, site('en').data.version)}</p>
			<Attribution lang={s.lang} />
		</article>
	</div>
</Layout>
