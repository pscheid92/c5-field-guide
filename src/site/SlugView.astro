---
// Domain, criterion or general-condition page, in either language.
import ConditionReader from './ConditionReader.astro';
import CriterionReader from './CriterionReader.astro';
import Layout from './Layout.astro';
import { GC, type Lang, groupByTheme, site } from './data';
import type { SlugProps } from './routes';

type Props = SlugProps & { lang: Lang };

const props = Astro.props;
const s = site(props.lang);
const { t } = s;
---

{
	props.kind === 'domain' &&
		(() => {
			const entry = s.domain(props.code)!;
			const isGc = props.code === GC;
			const criteria = isGc ? [] : s.criteriaIn(props.code);
			const rows = isGc
				? s.data.conditions.items.map((g) => ({ id: g.id, name: g.name, href: g.url, meta: '' }))
				: criteria.map((c) => {
						const basic = c.subs.filter((x) => x.kind === 'basic').length;
						const meta =
							t.subMeta(c.subs.length, basic, c.subs.length - basic) +
							(c.customerHtml ? `, ${t.withCustomer}` : '') +
							(c.changes.status === 'new' ? `, ${t.newInC5}` : '');
						return { id: c.id, name: c.name, href: c.url, meta };
					});
			// Themed criteria under their theme; runs of other criteria in one list.
			type Row = (typeof rows)[number] & { short: string };
			const blocks: { theme: string; items: Row[] }[] = [];
			for (const g of groupByTheme(rows)) {
				const last = blocks.at(-1);
				if ('theme' in g) blocks.push({ theme: g.theme, items: g.items });
				else if (last && !last.theme) last.items.push(g);
				else blocks.push({ theme: '', items: [g] });
			}
			const basic = criteria.reduce((n, c) => n + c.subs.filter((x) => x.kind === 'basic').length, 0);
			const additional = criteria.reduce((n, c) => n + c.subs.filter((x) => x.kind !== 'basic').length, 0);
			const row = (r: Row) => (
				<li>
					<a href={r.href}>
						<span class="overview-id">{r.id}</span>
						<span>
							<span class="overview-title">{r.short}</span>
							{r.meta && <span class="overview-meta">{r.meta}</span>}
						</span>
					</a>
				</li>
			);
			return (
				<Layout lang={props.lang} title={entry.title} view="domain" domain={props.code}>
					<div class="page">
						<article class="doc">
							<p class="crumb">
								<a href={`${s.home}#${t.domainsAnchor}`}>{t.domains}</a>
							</p>
							<p class="domain-code">{entry.code}</p>
							<h1>{entry.title}</h1>
							<p class="doc-meta">
								{isGc ? s.data.conditions.note : `${t.criteria(criteria.length)}, ${t.subCounts(basic, additional)}`}
							</p>
							{blocks.map((b) =>
								b.theme ? (
									<section class="overview-theme">
										<h2>{b.theme}</h2>
										<ul class="overview">{b.items.map(row)}</ul>
									</section>
								) : (
									<ul class="overview">{b.items.map(row)}</ul>
								),
							)}
							<p class="attribution" set:html={s.data.attribution} />
						</article>
					</div>
				</Layout>
			);
		})()
}

{
	props.kind === 'criterion' &&
		(() => {
			const c = s.criteriaById.get(props.id)!;
			return (
				<Layout lang={props.lang} title={`${c.id} ${c.name}`} view="item" domain={c.domain} current={c.id}>
					<CriterionReader site={s} criterion={c} />
				</Layout>
			);
		})()
}

{
	props.kind === 'condition' &&
		(() => {
			const g = s.data.conditions.items.find((x) => x.id === props.id)!;
			return (
				<Layout lang={props.lang} title={`${g.id} ${g.name}`} view="item" domain={GC} current={g.id}>
					<ConditionReader site={s} condition={g} />
				</Layout>
			);
		})()
}
